            "src/Rendering/Metal/CubismRenderTarget_Metal.mm": "-fno-objc-arc",
            "src/Rendering/Metal/CubismShader_Metal.mm": "-fno-objc-arc",
          },
          "exclusions": [
            "src/Rendering/Metal/Shaders/FragShaderSrcAlphaBlend.metal",
            "src/Rendering/Metal/Shaders/FragShaderSrcBlend.metal",
