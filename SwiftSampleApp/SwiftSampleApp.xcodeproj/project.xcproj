      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/SwiftSampleApp.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/libLive2DCubismFramework.a", "id": "EF92AC4930AB73B800B8454D", "type": "archive.ar", "index": false, "target-membership": [ { "build-phase": "SwiftSampleApp/frameworks", "platforms": [ "ios" ] } ] },
      ],
    }, {
      "kind": "folder",
      "path": "Live2DCubismSample",
