            "src/Rendering/Metal/Shaders/MetalShaders.metal",
            "src/Rendering/Metal/Shaders/VertShaderSrcBlend.metal",
            "src/Rendering/Metal/Shaders/VertShaderSrcMaskedBlend.metal",
          ],
        }, {
